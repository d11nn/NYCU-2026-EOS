+// 讀 config 的 tile_grids（例如 "2 4"）；沒寫就用 tile_grid 一個值
+std::vector<int> tile_grids ( const Config &cfg )
+{
+    std::vector<int> grids;
+    std::istringstream ss ( cfg.tile_grids );
+    int n;
+    while ( ss >> n ) grids.push_back ( n );
+    if ( grids.empty ( ) ) grids.push_back ( cfg.tile_grid );
+    return grids;
